# S3 Custom Backend Configuration (Optional)
# If these are not set, UploadThing uses its managed infrastructure.
# Set all 4 required vars to enable custom S3 backend.

# S3-compatible endpoint URL (e.g., Cloudflare R2, MinIO, AWS S3)
UPLOADTHING_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# S3 bucket name
UPLOADTHING_S3_BUCKET=your-bucket-name

# S3 access key ID
UPLOADTHING_S3_ACCESS_KEY=your-access-key-id

# S3 secret access key
UPLOADTHING_S3_SECRET_KEY=your-secret-access-key

# S3 region (default: us-east-1)
# Most S3-compatible providers accept any value or ignore it.
# AWS S3: use the actual region (us-east-1, eu-west-1, etc.)
# Cloudflare R2: accepts "auto" or any value
# MinIO: accepts any value
UPLOADTHING_S3_REGION=us-east-1

# Public base URL for accessing uploaded files
# Files will be accessible at: {UPLOADTHING_S3_PUBLIC_URL}/{key}
UPLOADTHING_S3_PUBLIC_URL=https://pub-YOUR_ACCOUNT_ID.r2.dev
